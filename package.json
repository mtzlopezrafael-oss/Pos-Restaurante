{
  "name": "pos-restaurante",
  "productName": "POS Restaurante",
  "version": "0.1.3",
  "description": "Punto de venta tactil para restaurante, compatible con Windows 7 x64",
  "main": "src/main/boot.js",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/run-tests.js",
    "dist": "node scripts/setup.js --win && electron-builder --win --x64",
    "bundle": "node scripts/release.js"
  },
  "dependencies": {
    "better-sqlite3": "9.6.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "mx.pos.restaurante",
    "productName": "POS Restaurante",
    "electronVersion": "22.3.27",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
